  "powershell_documented": [
    {
      "line": "a2>f",
      "parser": ["S|a2>f"],
      "reader": ["S|a2"],
      "reason": "To the parser `>` does not end a bare word, so this runs a command named `a2>f`, which no file can be called on Windows: nothing runs. The reader takes the redirection a bare word might be: it judges a write to `f` that does not happen, and can only deny more. It stays, because the same characters after a quote or a variable are a real redirection ('x'>f)."
    }
  ],
  "powershell_report": [
    "a>f",
    "cat a>f",
    "cat a2>f",
    "cat a<f"
  ],
  "alias_only_51": ["curl", "wget", "sc"],
  "alias_over": [
    {
      "alias": "sc",
      "reason": "`sc` is Set-Content in 5.1 and sc.exe in 7, and one reader judges both: the service rules see `sc x y`, and the write rules see `> x`. Under 5.1 the first is an over-read, which `sc stop saiifed` would deny for a write that names a file `saiifed`."
    }
  ],
