[Unit]
Description=saiife guest channel: model route to the host (tcp 127.0.0.1:3129, vsock 5002)

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3129,bind=127.0.0.1,reuseaddr,fork VSOCK-CONNECT:2:5002
RuntimeDirectory=saiife-guest
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
