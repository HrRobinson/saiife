[Unit]
Description=saiife guest channel: requests from the host (vsock 1024)

[Service]
ExecStart=/usr/bin/socat VSOCK-LISTEN:1024,reuseaddr,fork UNIX-CONNECT:/run/saiife-guest/control.sock
RuntimeDirectory=saiife-guest
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
